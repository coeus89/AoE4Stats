<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AoE4Stats.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AoE4Stats.Controls"
    xmlns:rows="using:AoE4Stats.Core.Presentation"
    Background="Transparent">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.PlayerName, Mode=OneWay}"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Visibility="{x:Bind ViewModel.NeedsPlayer, Mode=OneWay, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    <TextBlock Text="{x:Bind ViewModel.Country, Mode=OneWay}" Opacity="0.75" />
                    <TextBlock Text="{x:Bind ViewModel.Freshness, Mode=OneWay}" Opacity="0.7" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button
                        Content="AoE4 World"
                        Click="OpenProfile_Click"
                        Visibility="{x:Bind ViewModel.HasProfileLink, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                    <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                </StackPanel>
            </Grid>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Title="Profile unavailable"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsClosable="False" />

            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <ProgressRing IsActive="True" Width="20" Height="20" />
                <TextBlock Text="Loading the public profile…" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.NeedsPlayer, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <TextBlock Text="No player selected" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Search for a public profile. Ratings, ranks, wins, losses, and win rate appear here from that player's AoE4 World record."
                    TextWrapping="WrapWholeWords"
                    Opacity="0.75" />
            </StackPanel>

            <TextBlock
                Text="This profile has no seasonal or ELO numbers in the current response."
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.ShowEmptyModes, Mode=OneWay, Converter={StaticResource BoolVis}}" />

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasPrimary, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Season ladders" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.PrimaryCards, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:StretchWrapPanel MinItemWidth="280" ColumnSpacing="12" RowSpacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="rows:ModeCard">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind RankLevel}" Opacity="0.8" />
                                    <TextBlock Text="{x:Bind Rating}" Style="{ThemeResource TitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Rank, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Record}" />
                                    <TextBlock Text="{x:Bind WinRate}" />
                                    <TextBlock Text="{x:Bind Streak}" />
                                    <TextBlock Text="{x:Bind Season}" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind History}" Opacity="0.7" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind LastGame}" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind TopCivilization}" Opacity="0.7" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasLifetime, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Lifetime ELO" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="These are lifetime ELO blocks from the profile, separate from the current seasonal ladder."
                    Opacity="0.7"
                    TextWrapping="WrapWholeWords" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.LifetimeCards, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:StretchWrapPanel MinItemWidth="280" ColumnSpacing="12" RowSpacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="rows:ModeCard">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Rating}" Style="{ThemeResource TitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Rank}" />
                                    <TextBlock Text="{x:Bind Record}" />
                                    <TextBlock Text="{x:Bind WinRate}" />
                                    <TextBlock Text="{x:Bind LastGame}" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
