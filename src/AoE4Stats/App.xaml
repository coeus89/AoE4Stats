<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AoE4Stats.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:AoE4Stats.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolVis" />
            <converters:UriToImageSourceConverter x:Key="UriToImage" />
            <converters:ResultBrushConverter x:Key="ResultBrush" />
            <Thickness x:Key="PagePadding">28,20,28,24</Thickness>
            <x:Double x:Key="CardMinWidth">280</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
